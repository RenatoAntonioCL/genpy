#!/opt/homebrew/bin/bash
set -euo pipefail

# ─── DETECCIÓN DE ENTORNO ────────────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOCAL_LIB="$SCRIPT_DIR/../lib"
LOCAL_SCRIPTS="$SCRIPT_DIR/../scripts"
GLOBAL_LIB="/usr/local/share/genpy/lib"
GLOBAL_SCRIPTS="/usr/local/share/genpy/scripts"

# Definir rutas según si estamos en modo local (desarrollo) o instalado (global)
if [ -d "$LOCAL_LIB" ] && [ -d "$LOCAL_SCRIPTS" ]; then
    LIB_DIR="$LOCAL_LIB"
    SCRIPTS_DIR="$LOCAL_SCRIPTS"
    TEMPLATE_BASE_DIR="$SCRIPT_DIR/../templates"
else
    LIB_DIR="$GLOBAL_LIB"
    SCRIPTS_DIR="$GLOBAL_SCRIPTS"
    TEMPLATE_BASE_DIR="/usr/local/share/genpy/templates"
fi

export LIB_DIR TEMPLATE_BASE_DIR

# ─── MENÚ DE AYUDA GLOBAL ────────────────────────────────────────────────────
show_help() {
  echo -e "\n 🛠️  GenPy — project scaffolding tool v4.0.0\n"
  echo " Uso:"
  echo "   genpy create      Crear un nuevo proyecto"
  echo "   genpy update      Actualizar GenPy a la última versión"
  echo "   genpy uninstall   Desinstalar GenPy completamente"
  echo "   genpy version     Ver la versión instalada"
  echo ""
}

COMMAND="${1:-}"

case "$COMMAND" in
  create)
    source "$LIB_DIR/wizard.sh"
    ;;
    
  update)
    bash "$SCRIPTS_DIR/update.sh"
    ;;

  uninstall)
    bash "$SCRIPTS_DIR/uninstall.sh"
    ;;
  version)
    echo "GenPy v4.0.0"
    ;;
  *)
    show_help
    ;;
esac