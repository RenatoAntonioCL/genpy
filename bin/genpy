#!/bin/bash

INSTALL_DIR="/usr/local/share/genpy"
GENERATOR="$INSTALL_DIR/generador/genpy.sh"
INSTALLER="$INSTALL_DIR/instalador"

if [[ ! -f "$GENERATOR" ]]; then
  echo "❌ No se encontró el generador"
  exit 1
fi

case "$1" in
  create)
    shift
    bash "$GENERATOR" "$@"
    ;;

  update)
    bash "$INSTALLER/actualizar.sh"
    ;;

  uninstall)
    bash "$INSTALLER/desinstalar.sh"
    ;;

  *)
    echo "🛠️ GenPy v2.2.0"
    echo ""
    echo "Uso:"
    echo "  genpy create [lang] [--git] [--docker] [--venv]"
    echo "  genpy update"
    echo "  genpy uninstall"
    ;;
esac