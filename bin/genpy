#!/usr/bin/env bash
set -euo pipefail

# 1. Ubicación absoluta del script donde reside el código fuente (Developer/genpy/bin/genpy)
# _resolve_path: shim portable para readlink -f (GNU) vs macOS stock (BSD readlink sin -f).
# Consistente con el patrón _sed_inplace/_port_in_use del proyecto.
_resolve_path() {
  local target="$1"
  if command -v realpath &>/dev/null; then
    realpath "$target"
  elif readlink -f "$target" &>/dev/null 2>&1; then
    readlink -f "$target"
  else
    # Fallback manual: cd al directorio del archivo y capturar pwd
    local dir file
    dir="$(cd "$(dirname "$target")" && pwd)"
    file="$(basename "$target")"
    echo "$dir/$file"
  fi
}
BIN_PATH="$(_resolve_path "${BASH_SOURCE[0]}")"
PROJECT_ROOT="$(dirname "$(dirname "$BIN_PATH")")"

# 2. Definir directorios apuntando SIEMPRE al proyecto raíz de desarrollo
export LIB_DIR="$PROJECT_ROOT/lib"
export SCRIPTS_DIR="$PROJECT_ROOT/scripts"
export TEMPLATE_BASE_DIR="$PROJECT_ROOT/templates"

# 3. Validación de integridad
if [[ ! -d "$LIB_DIR" ]]; then
    echo "❌ Error: No se encontró el directorio de librerías en $LIB_DIR"
    exit 1
fi

source "$LIB_DIR/core/config.sh"  # 1. Cargar metadatos
source "$LIB_DIR/core/compat.sh"  # 2. Validar entorno
source "$LIB_DIR/utils.sh"        # 3. CARGAR COLORES (Añadir esta línea aquí) ✅

# 4. Ahora sí, cargar el idioma
export GENPY_LANG="${GENPY_LANG:-es}"
if [[ -f "$LIB_DIR/i18n/${GENPY_LANG}.sh" ]]; then
    source "$LIB_DIR/i18n/${GENPY_LANG}.sh"
else
    source "$LIB_DIR/i18n/es.sh"
fi


export LIB_DIR TEMPLATE_BASE_DIR

# ─── MENÚ DE AYUDA GLOBAL ────────────────────────────────────────────────────
show_help() {
  echo -e "\n 🛠️  GenPy — project scaffolding tool v${GENPY_VERSION}\n"
  echo " Uso:"
  echo "   genpy create      Crear un nuevo proyecto"
  echo "   genpy update      Actualizar GenPy a la última versión"
  echo "   genpy uninstall   Desinstalar GenPy completamente"
  echo "   genpy version     Ver la versión instalada"
  echo ""
}

COMMAND="${1:-}"

case "$COMMAND" in
    create)
        source "$LIB_DIR/wizard.sh" ;;
    update)
        bash "$SCRIPTS_DIR/update.sh" ;;
    uninstall)
        bash "$SCRIPTS_DIR/uninstall.sh" ;; 
    version)
        # Se elimina el texto hardcodeado para usar la constante de config.sh (R8)
        echo "GenPy v${GENPY_VERSION}" ;;
    *)
        show_help ;;
esac