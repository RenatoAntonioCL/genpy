#!/usr/bin/env bash
set -euo pipefail

# 1. Absolute path of the script where the source code lives (Developer/genpy/bin/genpy)
# _resolve_path: portable shim for readlink -f (GNU) vs macOS stock (BSD readlink without -f).
# Consistent with the _sed_inplace/_port_in_use pattern from the project.
_resolve_path() {
  local target="$1"
  if command -v realpath &>/dev/null; then
    realpath "$target"
  elif readlink -f "$target" &>/dev/null 2>&1; then
    readlink -f "$target"
  else
    # Manual fallback: cd to the file's directory and capture pwd
    local dir file
    dir="$(cd "$(dirname "$target")" && pwd)"
    file="$(basename "$target")"
    echo "$dir/$file"
  fi
}
BIN_PATH="$(_resolve_path "${BASH_SOURCE[0]}")"
PROJECT_ROOT="$(dirname "$(dirname "$BIN_PATH")")"

# 2. Define directories always pointing to the development project root
export LIB_DIR="$PROJECT_ROOT/lib"
export SCRIPTS_DIR="$PROJECT_ROOT/scripts"
export TEMPLATE_BASE_DIR="$PROJECT_ROOT/templates"

# 3. Integrity validation
if [[ ! -d "$LIB_DIR" ]]; then
    echo "❌ Error: Library directory not found at $LIB_DIR"
    exit 1
fi

source "$LIB_DIR/core/config.sh"  # 1. Load metadata
source "$LIB_DIR/core/compat.sh"  # 2. Validate environment
source "$LIB_DIR/utils.sh"

# 4. Now load the language
export GENPY_LANG="${GENPY_LANG:-es}"
if [[ -f "$LIB_DIR/i18n/${GENPY_LANG}.sh" ]]; then
    source "$LIB_DIR/i18n/${GENPY_LANG}.sh"
else
    source "$LIB_DIR/i18n/es.sh"
fi


export LIB_DIR TEMPLATE_BASE_DIR

# ─── GLOBAL HELP MENU ────────────────────────────────────────────────────────
show_help() {
  echo -e "\n 🛠️  GenPy — project scaffolding tool v${GENPY_VERSION}\n"
  echo " Usage:"
  echo "   genpy create      Create a new project"
  echo "   genpy review      Review code with AI (requires Ollama)"
  echo "   genpy update      Update GenPy to the latest version"
  echo "   genpy uninstall   Uninstall GenPy completely"
  echo "   genpy version     Show the installed version"
  echo ""
}

COMMAND="${1:-}"
shift 2>/dev/null || true

case "$COMMAND" in
    create)
        source "$LIB_DIR/wizard.sh" ;;
    review)
        source "$LIB_DIR/review.sh"
        genpy_review "$@" ;;
    update)
        bash "$SCRIPTS_DIR/update.sh" ;;
    uninstall)
        bash "$SCRIPTS_DIR/uninstall.sh" ;;
    version)
        echo "GenPy v${GENPY_VERSION}" ;;
    *)
        show_help ;;
esac
