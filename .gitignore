# =============================================================================
# GenPy — repositorio de la herramienta CLI
# =============================================================================

.DS_Store
**/.DS_Store
__pycache__/
*.pyc
*.log
.env
.env.*
# Los .env dentro de templates son fuente del CLI, no secretos reales
!templates/**/.env

# Herramientas locales (no versionar)
.aider*
.cursor/

# Proyectos generados en pruebas locales
project*/
test-*/

# =============================================================================
# También aplicable a proyectos que genere el CLI (copiado en templates)
# =============================================================================
venv/
.venv/
env/
ENV/
*.temp
*.tmp
